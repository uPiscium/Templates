use flake

if grep -q '@@PROJECT_NAME@@' pyproject.toml 2>/dev/null; then
  raw_name=$(basename "$PWD")
  safe_name=$(printf '%s' "$raw_name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_]/-/g')
  sed -i "s/@@PROJECT_NAME@@/$safe_name/g" pyproject.toml
fi

if [ -f pyproject.toml ]; then
  uv sync
fi

if [ -f .venv/bin/activate ]; then
  source .venv/bin/activate
fi
