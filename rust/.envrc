use flake

# =========================================================================
# 初回起動時の自動ブートストラップ機構 (Rust Safe Version)
# =========================================================================
if [ -f "Cargo.toml" ] && grep -q '@@PROJECT_NAME@@' Cargo.toml; then
  RAW_NAME=$(basename "$PWD")
  
  # Rustクレート名（パッケージ名）の安全規則に適合するようにサニタイズ
  SAFE_NAME=$(echo "$RAW_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_]/-/g')
  
  echo "==> Bootstrapping new Rust project: $SAFE_NAME"
  
  sed -i "s/@@PROJECT_NAME@@/$SAFE_NAME/g" Cargo.toml
  
  # srcディレクトリが存在しない場合は初期化
  if [ ! -d "src" ]; then
    mkdir src
  fi
fi

